{
  "name": "easygit",
  "productName": "EasyGit",
  "version": "2.1.1",
  "description": "Manage your projects without learning Git",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "predev": "node scripts/ensure-electron.js",
    "dev": "electron . --dev",
    "test": "node --test",
    "premake-icons": "node scripts/ensure-electron.js",
    "make-icons": "electron scripts/make-icons.js",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "git",
    "electron",
    "gui",
    "beginner",
    "non-technical"
  ],
  "author": {
    "name": "José Dantas Macedo",
    "email": "56549301+zemacedo99@users.noreply.github.com"
  },
  "contributors": [
    "Inês Caetano (product vision)",
    "José Dantas Macedo (development, with Claude)"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.zemacedo99.easygit",
    "productName": "EasyGit",
    "copyright": "Copyright (c) 2026 José Dantas Macedo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyGit",
      "include": "build/installer.nsh",
      "artifactName": "EasyGit-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EasyGit-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
