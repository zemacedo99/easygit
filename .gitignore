# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Packaged build output (electron-builder writes installers/portables here).
# Do NOT commit generated installers. Source icons under build/ ARE committed.
dist/
out/
release/
*.exe
*.msi
*.dmg
*.AppImage
*.snap
*.deb
*.blockmap

# Temp file produced by scripts/make-icons.js (auto-deleted; ignore stray copies)
src/renderer/assets/_icon_tmp.html

# Release executables are attached to GitHub Releases, never committed. Only
# the text files under versions/vX.Y.Z/ (release notes, SHA256SUMS.txt,
# update.json) are tracked; *.exe above also covers versions/.

# Local runtime data (EasyGit stores its repo list in the OS userData folder,
# not here, but ignore any stray local copies just in case)
repositories.json
*.tmp

# Demo captures (demo/shoot*.js) are generated locally, not committed
screenshots/
*.mp4
